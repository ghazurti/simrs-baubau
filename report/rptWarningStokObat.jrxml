			<textField isBlankWhenNull="true"><reportElement x="488" y="1" width="45"  height="12"/><textElement textAlignment="Left"  ><font fontName="Arial" size="8"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$F{temp6}]]></textFieldExpression></textField>
