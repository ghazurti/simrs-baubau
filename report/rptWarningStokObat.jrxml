			<staticText><reportElement x="607" y="4" width="60"  height="16"/><textElement textAlignment="Right" ><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Pakai/Hr]]></text></staticText>
			<staticText><reportElement x="669" y="4" width="50"  height="16"/><textElement textAlignment="Right" ><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Sisa Hr]]></text></staticText>
			<staticText><reportElement x="721" y="4" width="80"  height="16"/><textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Status]]></text></staticText>
