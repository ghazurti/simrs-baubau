	<title>
		<band height="90">
			<image scaleImage="RetainShape" hAlign="Center" vAlign="Middle">
				<reportElement x="0" y="0" width="60" height="60"/>
				<imageExpression class="java.io.InputStream"><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<textField isBlankWhenNull="true">
				<reportElement x="70" y="0" width="600" height="16"/>
				<textElement><font fontName="Arial" size="12" isBold="true"/></textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{namars}==null?"":$P{namars}.toUpperCase()]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="70" y="16" width="600" height="12"/>
				<textElement><font fontName="Arial" size="8"/></textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{alamatrs}+", "+$P{kotars}+", "+$P{propinsirs}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="70" y="28" width="600" height="12"/>
				<textElement><font fontName="Arial" size="8"/></textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Telp. "+$P{kontakrs}+" · Email: "+$P{emailrs}]]></textFieldExpression>
			</textField>
			<line><reportElement x="0" y="46" width="802" height="1"/><graphicElement><pen lineWidth="1.5"/></graphicElement></line>
			<line><reportElement x="0" y="49" width="802" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
			<staticText>
				<reportElement x="0" y="55" width="802" height="18"/>
				<textElement textAlignment="Center"><font fontName="Arial" size="13" isBold="true"/></textElement>
				<text><![CDATA[PERINGATAN STOK OBAT — DINAMIS BERDASARKAN PEMAKAIAN AKTUAL]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="74" width="802" height="12"/>
				<textElement textAlignment="Center"><font fontName="Arial" size="9" isItalic="true"/></textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[($P{gudang}==null?"":$P{gudang})+"  ·  "+($P{periode}==null?"":$P{periode})]]></textFieldExpression>
			</textField>
		</band>
	</title>

	<columnHeader>
