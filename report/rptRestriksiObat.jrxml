<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptRestriksiObat" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ro.kode_brng,db.nama_brng,ro.kdjenis,ro.kd_pj,ro.max_jml,ro.max_iterasi,ro.aktif,ro.keterangan,ro.restriksi_text,ro.level_faskes from restriksi_obat ro left join databarang db on db.kode_brng=ro.kode_brng order by ro.kode_brng]]>
	</queryString>
	<field name="kode_brng" class="java.lang.String"/>
	<field name="nama_brng" class="java.lang.String"/>
	<field name="kdjenis" class="java.lang.String"/>
	<field name="kd_pj" class="java.lang.String"/>
	<field name="max_jml" class="java.lang.Double"/>
	<field name="max_iterasi" class="java.lang.Integer"/>
	<field name="aktif" class="java.lang.String"/>
	<field name="keterangan" class="java.lang.String"/>
	<field name="restriksi_text" class="java.lang.String"/>
	<field name="level_faskes" class="java.lang.Integer"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="70" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="802" height="18"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="13" isBold="true"/></textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{namars}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="18" width="802" height="14"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="9"/></textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{alamatrs} + ", " + $P{kotars} + " - " + $P{propinsirs}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="32" width="802" height="12"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Telp: " + $P{kontakrs} + "  |  Email: " + $P{emailrs}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="48" width="802" height="18"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="11" isBold="true" isUnderline="true"/></textElement>
				<text><![CDATA[DAFTAR RESTRIKSI OBAT BPJS]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="68" width="802" height="1"/>
				<graphicElement><pen lineWidth="0.5"/></graphicElement>
			</line>
		</band>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band height="20" splitType="Stretch">
			<staticText><reportElement mode="Opaque" x="0" y="0" width="75" height="20" backcolor="#F0F0DC"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[ Kode]]></text></staticText>
			<staticText><reportElement mode="Opaque" x="75" y="0" width="175" height="20" backcolor="#F0F0DC"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[ Nama Obat]]></text></staticText>
			<staticText><reportElement mode="Opaque" x="250" y="0" width="40" height="20" backcolor="#F0F0DC"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle" textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[KdJns]]></text></staticText>
			<staticText><reportElement mode="Opaque" x="290" y="0" width="40" height="20" backcolor="#F0F0DC"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle" textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[KdPJ]]></text></staticText>
			<staticText><reportElement mode="Opaque" x="330" y="0" width="35" height="20" backcolor="#F0F0DC"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle" textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[Max Jml]]></text></staticText>
			<staticText><reportElement mode="Opaque" x="365" y="0" width="35" height="20" backcolor="#F0F0DC"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle" textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[Iter]]></text></staticText>
			<staticText><reportElement mode="Opaque" x="400" y="0" width="25" height="20" backcolor="#F0F0DC"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle" textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[Akt]]></text></staticText>
			<staticText><reportElement mode="Opaque" x="425" y="0" width="130" height="20" backcolor="#F0F0DC"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[ Keterangan]]></text></staticText>
			<staticText><reportElement mode="Opaque" x="555" y="0" width="200" height="20" backcolor="#F0F0DC"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[ Restriksi Indikasi Fornas]]></text></staticText>
			<staticText><reportElement mode="Opaque" x="755" y="0" width="47" height="20" backcolor="#F0F0DC"/><box><pen lineWidth="0.5"/></box><textElement verticalAlignment="Middle" textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[Lvl Faskes]]></text></staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="22" splitType="Stretch">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="75" height="22"/><box leftPadding="2"><pen lineWidth="0.25"/></box><textElement verticalAlignment="Top"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$F{kode_brng}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToBandHeight" x="75" y="0" width="175" height="22"/><box leftPadding="2"><pen lineWidth="0.25"/></box><textElement verticalAlignment="Top"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$F{nama_brng}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToBandHeight" x="250" y="0" width="40" height="22"/><box><pen lineWidth="0.25"/></box><textElement verticalAlignment="Top" textAlignment="Center"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$F{kdjenis}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToBandHeight" x="290" y="0" width="40" height="22"/><box><pen lineWidth="0.25"/></box><textElement verticalAlignment="Top" textAlignment="Center"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$F{kd_pj}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true" pattern="#,##0.##"><reportElement stretchType="RelativeToBandHeight" x="330" y="0" width="35" height="22"/><box rightPadding="2"><pen lineWidth="0.25"/></box><textElement verticalAlignment="Top" textAlignment="Right"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression class="java.lang.Double"><![CDATA[$F{max_jml}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToBandHeight" x="365" y="0" width="35" height="22"/><box rightPadding="2"><pen lineWidth="0.25"/></box><textElement verticalAlignment="Top" textAlignment="Right"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression class="java.lang.Integer"><![CDATA[$F{max_iterasi}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToBandHeight" x="400" y="0" width="25" height="22"/><box><pen lineWidth="0.25"/></box><textElement verticalAlignment="Top" textAlignment="Center"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$F{aktif}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToBandHeight" x="425" y="0" width="130" height="22"/><box leftPadding="2"><pen lineWidth="0.25"/></box><textElement verticalAlignment="Top"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$F{keterangan}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToBandHeight" x="555" y="0" width="200" height="22"/><box leftPadding="2"><pen lineWidth="0.25"/></box><textElement verticalAlignment="Top"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$F{restriksi_text}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToBandHeight" x="755" y="0" width="47" height="22"/><box><pen lineWidth="0.25"/></box><textElement verticalAlignment="Top" textAlignment="Center"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$F{level_faskes}==null?"":$F{level_faskes}==0?"ALL":$F{level_faskes}==1?"FKTP":$F{level_faskes}==2?"FKRTL 2":"FKRTL 3"]]></textFieldExpression></textField>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band height="20" splitType="Stretch">
			<line><reportElement x="0" y="0" width="802" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
			<textField pattern="dd/MM/yyyy HH.mm.ss"><reportElement x="2" y="3" width="120" height="14"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression class="java.util.Date"><![CDATA[new Date()]]></textFieldExpression></textField>
			<staticText><reportElement x="125" y="3" width="50" height="14"/><textElement><font fontName="Tahoma" size="8"/></textElement><text><![CDATA[Record :]]></text></staticText>
			<textField><reportElement x="175" y="3" width="60" height="14"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression class="java.lang.String"><![CDATA[$V{REPORT_COUNT}.toString()]]></textFieldExpression></textField>
			<textField><reportElement x="680" y="3" width="80" height="14"/><textElement textAlignment="Right"><font fontName="Tahoma" size="8"/></textElement><textFieldExpression class="java.lang.String"><![CDATA["Halaman " + $V{PAGE_NUMBER} + " dari "]]></textFieldExpression></textField>
			<textField evaluationTime="Report"><reportElement x="762" y="3" width="40" height="14"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression class="java.lang.String"><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
		</band>
	</pageFooter>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
