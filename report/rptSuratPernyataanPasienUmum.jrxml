			<staticText>
				<reportElement x="0" y="256" width="515" height="30"/>
				<textElement textAlignment="Justified"><font fontName="Arial" size="10"/></textElement>
				<text><![CDATA[Apabila ada perubahan penjaminan akan saya selesaikan dalam waktu 3 hari kerja dan mengikuti ketentuan yang berlaku sesuai dengan ketentuan persyaratan penjaminan.]]></text>
			</staticText>

			<staticText>
				<reportElement x="0" y="292" width="515" height="30"/>
				<textElement textAlignment="Justified"><font fontName="Arial" size="10"/></textElement>
				<text><![CDATA[Sebagai pasien Jaminan Kesehatan Nasional maka saya bersedia mengurus Surat Eligibilitas Peserta (SEP) dalam waktu 3 hari kerja dan mengikuti ketentuan yang berlaku.]]></text>
			</staticText>

			<staticText>
				<reportElement x="0" y="328" width="515" height="30"/>
				<textElement textAlignment="Justified"><font fontName="Arial" size="10"/></textElement>
				<text><![CDATA[Apabila sampai batas waktu yang telah ditentukan saya belum selesai mengurus SEP maka saya bersedia membayar seluruh biaya perawatan sebagai pasien Umum.]]></text>
			</staticText>

			<staticText>
				<reportElement x="0" y="364" width="515" height="45"/>
				<textElement textAlignment="Justified"><font fontName="Arial" size="10"/></textElement>
				<text><![CDATA[Saya juga menyadari apabila saya telah menentukan sebagai pasien Umum, maka saya tidak akan merubah cara bayar menjadi pasien Jaminan Kesehatan Nasional / tidak mampu dan bersedia membayar seluruh biaya rumah sakit sesuai dengan ketentuan yang berlaku.]]></text>
