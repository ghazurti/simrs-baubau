	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="nosurat" class="java.lang.String"/>
	<parameter name="obatNama" class="java.lang.String"/>
	<parameter name="obatJml" class="java.lang.String"/>
	<parameter name="obatDosis" class="java.lang.String"/>
	<queryString>
		<![CDATA[select sep.no_rawat,sep.no_sep,sep.no_kartu,sep.nama_pasien,sep.diagawal,sep.nmdiagnosaawal,
ps.no_ktp,ps.alamat,ps.no_tlp,kel.nm_kel,kec.nm_kec,kab.nm_kab,dr.nm_dokter,rp.tgl_registrasi
from bridging_sep sep
inner join reg_periksa rp on rp.no_rawat=sep.no_rawat
inner join pasien ps on ps.no_rkm_medis=sep.nomr
left join kelurahan kel on kel.kd_kel=ps.kd_kel
left join kecamatan kec on kec.kd_kec=ps.kd_kec
left join kabupaten kab on kab.kd_kab=ps.kd_kab
left join dokter dr on dr.kd_dokter=rp.kd_dokter]]>
	</queryString>
	<field name="no_rawat" class="java.lang.String"/>
	<field name="no_sep" class="java.lang.String"/>
	<field name="no_kartu" class="java.lang.String"/>
	<field name="nama_pasien" class="java.lang.String"/>
	<field name="diagawal" class="java.lang.String"/>
